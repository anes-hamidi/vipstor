# Copy this file to .env and fill in the real values.
# .env is git-ignored; never commit real credentials.
#
# scripts/publish_release.ps1 reads .env automatically (environment variables
# take precedence). Flutter reads it via --dart-define-from-file=.env.
#
# Supabase Dashboard > Project Settings > API:
#   SUPABASE_URL              Project URL (https://<ref>.supabase.co)
#   SUPABASE_ANON_KEY         anon public key (safe to embed in the app)
#   SUPABASE_SERVICE_ROLE_KEY service_role key (publishing only, never in the app)

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Only needed by scripts/publish_release.ps1:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
